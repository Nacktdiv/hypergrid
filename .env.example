# Salin file ini menjadi `.env` lalu isi dengan API key Google Maps kamu.
#
# Cloud console: https://console.cloud.google.com/apis/credentials
#   1. Enable "Maps SDK for Android" pada project Google Cloud
#   2. Buat API key, batasi ke aplikasi Android
#   3. Tambahkan package name: com.nacktdiv.hypergrid
#   4. Tambahkan SHA-1 certificate fingerprint
#
# iOS memakai Apple Maps sehingga TIDAK memerlukan API key.

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
